# Copy to /root/tiffin/.env (install.sh does this for you) and fill in. Keep this file private: chmod 600.
PORT=3000
HOST=127.0.0.1                  # only the local HTTPS proxy (Caddy) may reach the app
TZ=Asia/Kolkata
DATA_DIR=/root/tiffin/data
PUBLIC_URL=https://mytiffin.online
FORCE_HTTPS=1
COUNTRY=in
GEOCODER_CONTACT=you@example.com   # your email; OpenStreetMap's geocoder asks callers to identify themselves
# Optional Telegram alerts (create the bot with @BotFather, see /help#telegram-owner):
TELEGRAM_BOT_USERNAME=tiffincrm_bot   # shown on the site; the real one is confirmed with Telegram when the token is set
TELEGRAM_BOT_TOKEN=
